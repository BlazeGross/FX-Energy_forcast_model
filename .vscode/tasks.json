{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dashboard",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "streamlit", "run", "app.py"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
